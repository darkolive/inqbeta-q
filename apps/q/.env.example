# Copy to .env and fill in. Vite loads env from this directory, not the repo root.

# Resend API key. The From: address must be on a domain verified with Resend,
# or delivery is refused outright.
RESEND_API_KEY=

# Who Q's mail comes from, e.g. Q <q@example.org>. Unset: Dark Olive's own
# address, which only works with Dark Olive's Resend account.
Q_MAIL_FROM=

# The one inbox the home page's "Stay in touch" sign-ups go to (api/interest).
# Nothing is sent anywhere else, and the address is not kept on the server.
Q_INTEREST_TO=

# Q's sending key: 32 bytes, base64url.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# A channel receipt seals its address to two keys — the person's, and this one.
# This one exists so a sign-in code can reach someone who has not signed in yet,
# which is every returning person. Anything holding this seed can open every
# channel sealed to it. Treat it as you would the mail key.
#
# Leave it unset and Q still works: channels seal to their owner alone, and a
# code can only be sent to an address typed in by hand.
Q_SERVICE_SEED=

# Encrypts the sign-in challenge the browser carries between sending a code and
# answering it. Any long random string. Rotating it invalidates codes in flight.
Q_OTP_SECRET=

# Calls (ADR-Q-004). A TURN relay for networks that will not let two devices
# reach each other directly. Cloudflare Realtime → TURN → create a key.
# Leave unset and calls use STUN only: fine on most home networks, not all.
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# Google Drive as a storage channel — a "Web application" OAuth client in
# Google Cloud Console, Drive API enabled, scope drive.file. The secret stays
# on the server; it only ever exchanges or refreshes a token. Never commit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The root domain passkeys belong to (passkey.ts). Q may live at any address
# under it and every passkey still works. Must be a real registered domain the
# page is served from or under — a browser refuses anything else. Leave unset
# for localhost and *.vercel.app test sites: passkeys there are test identities.
# Production: inqbeta.com. The inqbeta.dev test site: inqbeta.dev.
PUBLIC_Q_PASSKEY_DOMAIN=
