{
	"name": "@inqbeta/q-actions",
	"license": "Apache-2.0",
	"version": "0.1.0",
	"private": true,
	"description": "Actions: what may, must and cannot happen, as Cedar policies, decided on the spot (ADR-Q-008, ADR-Q-009).",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"dependencies": {
		"@inqbeta/q-core": "workspace:*",
		"@cedar-policy/cedar-wasm": "4.13.0"
	},
	"scripts": {
		"test": "node --experimental-strip-types --no-warnings --import ./test/register.mjs --test test/*.test.ts",
		"export-actions": "node --experimental-strip-types --no-warnings --import ./test/register.mjs scripts/export-actions.ts"
	}
}
